# Copy this file to .env and fill in your key to use real AI-graded interviews.
# Leave ANTHROPIC_API_KEY blank to run in demo mode (FakeInterviewAiClient -
# heuristic scoring, no network calls, no cost).

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

DATABASE_URL=jdbc:postgresql://localhost:5432/mock_interview
DATABASE_USER=mock_interview
DATABASE_PASSWORD=mock_interview

PORT=8080
